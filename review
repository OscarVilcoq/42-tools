cat << 'EOF' >> ~/.bashrc

r() {
    rm -rf ~/review/* && cd ~/review || return
    if git clone "$1"; then
        cd "$(basename "$1" .git)" || return
        echo -e "\n=== 🛠️ RUNNING NORMINETTE ==="
        norminette
        echo -e "\n=== 📂 REPOSITORY TREE ==="
        tree
        code .
    else
        echo "Erreur : Le clonage du dépôt a échoué."
    fi
}
EOF

source ~/.bashrc


